{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "infrastructure/database/generated/**/*",
        "exclude": "infrastructure/database/generated/**/*.ts",
        "watchAssets": true
      }
    ]
  }
}
