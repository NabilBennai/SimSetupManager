# Développement local : fichier SQLite local (voir .agents/todo-user.md pour Turso réel).
DATABASE_URL="file:./prisma/local.db"

# Renseigné uniquement pour les environnements pointant vers Turso (preview/production).
# TURSO_AUTH_TOKEN=

# Niveau des logs pino (trace|debug|info|warn|error|fatal). Défaut : info.
# LOG_LEVEL=info

# Swagger (/docs) est actif hors production par défaut. En production,
# il faut positionner explicitement SWAGGER_ENABLED=true pour l'exposer.
# SWAGGER_ENABLED=true

# Origine autorisée en CORS pour les cookies de session (credentials: true).
# Défaut : http://localhost:4200.
# APP_ORIGIN=http://localhost:4200

# Durée de vie d'une session (jours). Défaut : 30.
# SESSION_TTL_DAYS=30

# Stockage des fichiers de setup (disque local, voir infrastructure/storage).
# Secret HMAC signant les URLs d'upload/téléchargement. Un secret de
# développement est utilisé par défaut avec un avertissement dans les logs —
# à définir explicitement avant tout déploiement.
# STORAGE_SECRET=
# Taille max d'un fichier de setup en octets. Défaut : 20971520 (20 Mo).
# MAX_UPLOAD_SIZE_BYTES=20971520
# Durée de validité d'une URL d'upload signée (ms). Défaut : 900000 (15 min).
# UPLOAD_URL_TTL_MS=900000
# Durée de validité d'une URL de téléchargement signée (ms). Défaut : 300000 (5 min).
# DOWNLOAD_URL_TTL_MS=300000
# Origine publique de l'API, utilisée pour construire les URLs d'upload/
# téléchargement. Défaut : http://localhost:3000.
# API_ORIGIN=http://localhost:3000
