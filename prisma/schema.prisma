datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/infrastructure/database/generated"
}

// SQLite (Turso) ne supporte pas les enums Prisma : role/status sont des
// String dont les valeurs autorisées sont validées côté application
// (voir apps/api/src/modules/users).
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  displayName   String
  avatarUrl     String?
  role          String         @default("MEMBER")
  status        String         @default("ACTIVE")
  preferences   String         @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  sessions      Session[]
  setups        Setup[]
  fileObjects   FileObject[]
  uploadIntents UploadIntent[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

// SQLite n'a pas de type array natif : supportedExtensions est un JSON
// sérialisé (voir apps/api/src/modules/references).
model Game {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  isActive            Boolean  @default(true)
  supportedExtensions String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categories    CarCategory[]
  cars          Car[]
  uploadIntents UploadIntent[]
  setups        Setup[]
}

model CarCategory {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name   String

  cars Car[]

  @@unique([gameId, name])
}

model Car {
  id           String       @id @default(cuid())
  gameId       String
  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     CarCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug         String
  manufacturer String
  name         String
  isActive     Boolean      @default(true)
  setups       Setup[]

  @@unique([gameId, slug])
  @@index([gameId, isActive])
  @@index([categoryId])
}

model Track {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  layout      String?
  countryCode String
  isActive    Boolean @default(true)
  setups      Setup[]

  @@index([name])
}

model Setup {
  id                 String         @id @default(cuid())
  ownerId            String
  owner              User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  gameId             String
  game               Game           @relation(fields: [gameId], references: [id])
  carId              String
  car                Car            @relation(fields: [carId], references: [id])
  trackId            String
  track              Track          @relation(fields: [trackId], references: [id])
  title              String
  descriptionPublic  String?
  notesPrivate       String?
  visibility         String         @default("PRIVATE")
  sessionType        String?
  weather            String?
  trackTemperatureC  Float?
  airTemperatureC    Float?
  gameVersion        String?
  referenceVersionId String?        @unique
  referenceVersion   SetupVersion?  @relation("SetupReference", fields: [referenceVersionId], references: [id])
  isArchived         Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  versions           SetupVersion[] @relation("SetupVersions")
  tags               TagLink[]

  @@index([ownerId, isArchived, updatedAt])
  @@index([ownerId, gameId])
  @@index([ownerId, carId])
  @@index([ownerId, trackId])
}

// Noms normalisés (trim + minuscules) pour éviter les quasi-doublons.
model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  links TagLink[]
}

model TagLink {
  id      String @id @default(cuid())
  setupId String
  setup   Setup  @relation(fields: [setupId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([setupId, tagId])
  @@index([tagId])
}

model SetupVersion {
  id            String     @id @default(cuid())
  setupId       String
  setup         Setup      @relation("SetupVersions", fields: [setupId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileObjectId  String
  fileObject    FileObject @relation(fields: [fileObjectId], references: [id])
  changeNotes   String?
  createdAt     DateTime   @default(now())

  referencedBy Setup? @relation("SetupReference")

  @@unique([setupId, versionNumber])
}

// uploadedByUserId n'est pas dans docs/06-modele-de-donnees.md mais est
// nécessaire pour vérifier qu'un fileId fourni à POST /setups appartient
// bien à l'appelant avant d'être attaché à une version.
model FileObject {
  id               String         @id @default(cuid())
  uploadedByUserId String
  uploadedBy       User           @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  storageProvider  String
  storageKey       String         @unique
  originalName     String
  mimeType         String
  extension        String
  sizeBytes        Int
  sha256           String
  status           String         @default("VALIDATED")
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?
  versions         SetupVersion[]
}

model UploadIntent {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId            String
  game              Game      @relation(fields: [gameId], references: [id])
  storageKey        String    @unique
  originalName      String
  mimeType          String
  expectedExtension String
  expectedSizeBytes Int
  status            String    @default("PENDING")
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([status, expiresAt])
}
