datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/infrastructure/database/generated"
}

// SQLite (Turso) ne supporte pas les enums Prisma : role/status sont des
// String dont les valeurs autorisées sont validées côté application
// (voir apps/api/src/modules/users).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         String    @default("MEMBER")
  status       String    @default("ACTIVE")
  preferences  String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

// SQLite n'a pas de type array natif : supportedExtensions est un JSON
// sérialisé (voir apps/api/src/modules/references).
model Game {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  isActive            Boolean  @default(true)
  supportedExtensions String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categories CarCategory[]
  cars       Car[]
}

model CarCategory {
  id     String @id @default(cuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name   String

  cars Car[]

  @@unique([gameId, name])
}

model Car {
  id           String       @id @default(cuid())
  gameId       String
  game         Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     CarCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug         String
  manufacturer String
  name         String
  isActive     Boolean      @default(true)

  @@unique([gameId, slug])
  @@index([gameId, isActive])
  @@index([categoryId])
}

model Track {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  layout      String?
  countryCode String
  isActive    Boolean @default(true)

  @@index([name])
}
